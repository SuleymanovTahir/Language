# Vercel Marketplace PostgreSQL connection string
DATABASE_URL=

# Public origin of the deployed application (or http://localhost:8443 for local Vercel dev)
BETTER_AUTH_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SMTP sender for account confirmation and password recovery emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: email address that owns the production admin hierarchy
LINGUAPLAY_OWNER_EMAIL=

# Optional server-side speech providers; do not prefix these with VITE_
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required before enabling automatic placement writing assessment; these are shared database-backed request limits.
GEMINI_DAILY_ASSESSMENT_LIMIT=8
GEMINI_MONTHLY_ASSESSMENT_LIMIT=

# Set in Vercel to authorize the scheduled 90-day event cleanup.
CRON_SECRET=

# Optional database-backed limits for private user media.
LINGUAPLAY_MEDIA_USER_QUOTA_BYTES=52428800
LINGUAPLAY_MEDIA_PROJECT_QUOTA_BYTES=524288000

# Server-managed game energy; the account cap cannot exceed the schema maximum of 22.
LINGUAPLAY_ENERGY_CAP=5
LINGUAPLAY_ENERGY_REFILL_MINUTES=30

# Paid speech providers stay disabled unless both limits are configured; limits count submitted characters.
# Generate with: openssl rand -hex 32; set the same secret for the Python and TypeScript functions.
LINGUAPLAY_INTERNAL_TTS_SECRET=
LINGUAPLAY_TTS_AZURE_USER_DAILY_CHARS=20000
LINGUAPLAY_TTS_AZURE_PROJECT_MONTHLY_CHARS=300000
LINGUAPLAY_TTS_ELEVENLABS_USER_DAILY_CHARS=10000
LINGUAPLAY_TTS_ELEVENLABS_PROJECT_MONTHLY_CHARS=100000
