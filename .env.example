# Vercel Marketplace PostgreSQL connection string
DATABASE_URL=

# Public origin of the deployed application (or http://localhost:8443 for local Vercel dev)
BETTER_AUTH_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SMTP sender for account confirmation and password recovery emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: email address that owns the production admin hierarchy
LINGUAPLAY_OWNER_EMAIL=
